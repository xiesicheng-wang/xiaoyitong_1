.row { display: flex; justify-content: space-between; align-items: center; }
.big { font-size: 44rpx; font-weight: 700; }
.frozen { color: #ba7517; }
.recharge-row { display: flex; gap: 16rpx; margin-top: 24rpx; align-items: center; }
.input { flex: 1; background: #fdf3f7; border-radius: 12rpx; padding: 18rpx 24rpx; font-size: 28rpx; }
.recharge { margin: 0; }
.tip { margin-top: 14rpx; }
.sec { font-weight: 600; margin-bottom: 16rpx; }
.log { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f6e2ea; }
.in { color: #5fb878; font-weight: 600; }
.out { color: #e0557f; font-weight: 600; }
