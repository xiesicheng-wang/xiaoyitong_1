<view class="page">
  <view class="card">
    <view class="row">
      <view>
        <view class="muted">可用余额（元）</view>
        <view class="big price">{{wallet.balance || '0.00'}}</view>
      </view>
      <view>
        <view class="muted">冻结中（元）</view>
        <view class="big frozen">{{wallet.frozen || '0.00'}}</view>
      </view>
    </view>
    <view class="recharge-row">
      <input class="input" type="digit" placeholder="充值金额" value="{{amount}}" bindinput="onInput" />
      <button class="btn-primary recharge" size="mini" loading="{{loading}}" bindtap="recharge">充值</button>
    </view>
    <view class="muted tip">模拟充值（真实支付见 docs/支付宝沙箱接入指南.md）</view>
  </view>

  <view class="card">
    <view class="sec">钱包流水</view>
    <view wx:for="{{logs}}" wx:key="id" class="log">
      <view>
        <view>{{item.remark || typeName(item.type)}}</view>
        <view class="muted">{{item.createTime}}</view>
      </view>
      <view class="{{isIncome(item.type) ? 'in' : 'out'}}">
        {{isIncome(item.type) ? '+' : '-'}}{{item.amount}}
      </view>
    </view>
    <view wx:if="{{!logs.length}}" class="muted">暂无流水</view>
  </view>
</view>
