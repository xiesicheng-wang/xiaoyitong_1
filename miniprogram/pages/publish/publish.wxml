<view class="page">
  <view class="card">
    <view class="sec">发布二手商品</view>
    <input class="input" placeholder="标题（如：九成新山地车）" value="{{title}}" bindinput="onInput" data-field="title" />
    <picker range="{{categories}}" bindchange="onCategory">
      <view class="input picker">分类：{{category}}</view>
    </picker>
    <input class="input" placeholder="价格（元）" type="digit" value="{{price}}" bindinput="onInput" data-field="price" />
    <textarea class="input area" placeholder="描述：成色、购买时间、交易方式" value="{{description}}"
              bindinput="onInput" data-field="description" maxlength="500" />
    <button class="upload" size="mini" bindtap="chooseImage">{{images.length ? `已选 ${images.length} 张图` : '+ 添加图片'}}</button>
    <button class="btn-primary submit" loading="{{loading}}" bindtap="submit">发布</button>
  </view>
</view>
