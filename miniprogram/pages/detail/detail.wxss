.page { padding-bottom: 40rpx; }
.cat { margin-bottom: 8rpx; }
.title { font-size: 34rpx; font-weight: 700; margin: 8rpx 0 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.big { font-size: 40rpx; }
.fav { color: #999; font-size: 26rpx; }
.fav-on { color: #ee7bab; font-weight: 600; }
.sec { font-weight: 600; margin-bottom: 14rpx; }
.review { border-bottom: 1rpx solid #f6e2ea; padding: 14rpx 0; }
.review-name { color: #c94d7e; font-weight: 600; font-size: 26rpx; }
.buy { margin-top: 30rpx; }
.tip { text-align: center; margin-top: 14rpx; }
