.tabs { display: flex; padding: 20rpx 24rpx 0; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; background: #fff; font-size: 28rpx; color: #6b5b62; }
.tab:first-child { border-radius: 12rpx 0 0 12rpx; }
.tab:last-child { border-radius: 0 12rpx 12rpx 0; }
.tab-active { background: #ee7bab; color: #fff; font-weight: 600; }
.row { display: flex; justify-content: space-between; align-items: center; }
.title { font-weight: 600; margin: 10rpx 0; }
.status { font-size: 24rpx; }
.s0 { color: #ba7517; } .s1 { color: #5fb878; } .s2 { color: #999; } .s3 { color: #e0557f; }
.btns { display: flex; gap: 12rpx; margin-top: 14rpx; justify-content: flex-end; }
.btn-ok { background: #5fb878; color: #fff; border-radius: 30rpx; }
.btn-cancel { background: #fdf3f7; color: #e0557f; border-radius: 30rpx; }
.btn-review { background: #fff; color: #ee7bab; border-radius: 30rpx; }
.btn-review.done { color: #bbb; }
.empty { text-align: center; padding: 60rpx 0; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 10; }
.dialog { width: 600rpx; margin: 0; }
.stars { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.star { font-size: 44rpx; color: #ddd; }
.star-on { color: #ee7bab; }
.input { background: #fdf3f7; border-radius: 12rpx; padding: 20rpx; font-size: 26rpx; }
.area { height: 140rpx; }
.sec { font-weight: 600; margin-bottom: 16rpx; }
